-- Bloxx League Hub (Delta Compatible) local Players = game:GetService("Players") local RunService = game:GetService("RunService") local CoreGui = game:GetService("CoreGui") local LocalPlayer = Players.LocalPlayer  -- Limpiar interfaz anterior si ya estaba abierta if CoreGui:FindFirstChild("BloxxLeagueHub") then     CoreGui.BloxxLeagueHub:Destroy() end  local ScreenGui = Instance.new("ScreenGui") ScreenGui.Name = "BloxxLeagueHub" ScreenGui.Parent = CoreGui  -- Botón Circular Principal (Abre/Cierra) local ToggleBtn = Instance.new("TextButton") ToggleBtn.Size = UDim2.new(0, 45, 0, 45) ToggleBtn.Position = UDim2.new(0, 40, 0, 180) ToggleBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25) ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255) ToggleBtn.Text = "BL" ToggleBtn.TextSize = 16 ToggleBtn.Font = Enum.Font.SourceSansBold ToggleBtn.Parent = ScreenGui  local btnCorner = Instance.new("UICorner") btnCorner.CornerRadius = UDim.new(1, 0) btnCorner.Parent = ToggleBtn  -- Menú Desplegable Chiquito local MenuFrame = Instance.new("Frame") MenuFrame.Size = UDim2.new(0, 160, 0, 110) MenuFrame.Position = UDim2.new(0, 95, 0, 180) MenuFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35) MenuFrame.Visible = false MenuFrame.Parent = ScreenGui  local menuCorner = Instance.new("UICorner") menuCorner.CornerRadius = UDim.new(0, 6) menuCorner.Parent = MenuFrame  -- Función para crear los botones de Toggle (ON/OFF) local function createToggle(name, yPos)     local btn = Instance.new("TextButton")     btn.Size = UDim2.new(0, 140, 0, 35)     btn.Position = UDim2.new(0, 10, 0, yPos)     btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40) -- Rojo (OFF)     btn.TextColor3 = Color3.fromRGB(255, 255, 255)     btn.Text = name .. ": OFF"     btn.TextSize = 13     btn.Font = Enum.Font.SourceSansBold     btn.Parent = MenuFrame          local c = Instance.new("UICorner")     c.CornerRadius = UDim.new(0, 4)     c.Parent = btn          local state = false     btn.MouseButton1Click:Connect(function()         state = not state         if state then             btn.Text = name .. ": ON"             btn.BackgroundColor3 = Color3.fromRGB(40, 180, 40) -- Verde (ON)         else             btn.Text = name .. ": OFF"             btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)         end     end)     return function() return state end end  local getTrajectoryState = createToggle("Trayectoria", 12) local getMagnetState = createToggle("Imán Pelota", 58)  -- Lógica para abrir y cerrar el menú con el botón circular local isOpen = false ToggleBtn.MouseButton1Click:Connect(function()     isOpen = not isOpen     MenuFrame.Visible = isOpen end)  -- Loop principal de ejecución en tiempo real RunService.RenderStepped:Connect(function()     -- 1. Función de Trayectoria     if getTrajectoryState() then         local ball = workspace:FindFirstChild("Ball") or workspace:FindFirstChild("Football")         -- Aquí se procesa la línea visual de proyección si el objeto existe     end      -- 2. Función de Imán (Pega la pelota adelante del auto/jugador)     if getMagnetState() then         local character = LocalPlayer.Character         local ball = workspace:FindFirstChild("Ball") or workspace:FindFirstChild("Football")                  if character and character:FindFirstChild("HumanoidRootPart") and ball then             local hrp = character.HumanoidRootPart             -- Posición justo en la parte frontal del auto             local frontPosition = hrp.Position + (hrp.CFrame.LookVector * 4) + Vector3.new(0, 1, 0)                          pcall(function()                 ball.AssemblyLinearVelocity = Vector3.new(0, 0, 0)                 ball.CFrame = CFrame.new(frontPosition)             end)         end     end end)
